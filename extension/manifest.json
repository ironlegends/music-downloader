{
  "manifest_version": 3,
  "name": "Music Downloader",
  "version": "2.0.0",
  "description": "Convert Spotify links and download music through SpotMate.",
  "content_scripts": [
    {
      "matches": [
        "https://spotmate.online/en1",
        "https://spotmate.online/en1/"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "assets/playlist-panel.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
